# Copy to archmorph.env (never commit it) and enable env_file in docker-compose.yml.
# Keep the single quotes: bcrypt hashes contain '$'.
ARCHMORPH_SECURITY_AUTH_MODE=BASIC
ARCHMORPH_SECURITY_AUTH_USERS_0_USERNAME=ada
ARCHMORPH_SECURITY_AUTH_USERS_0_PASSWORDHASH='{bcrypt}$2a$12$replace.with.the.output.of.hash-password.................'
